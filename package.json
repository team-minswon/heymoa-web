{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "orval": "orval",
    "orval:watch": "orval --watch",
    "verify": "pnpm lint && pnpm typecheck && pnpm build",
    "clean:next": "rm -rf .next",
    "dev:clean": "pnpm clean:next && pnpm dev",
    "test": "vitest",
    "test:run": "vitest run",
    "asyncapi:validate": "asyncapi validate asyncapi.yml",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.4.0",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.78.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@asyncapi/cli": "^6.0.2",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "orval": "^8.16.0",
    "prettier": "^3.8.4",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "yaml": "2.9.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.19",
      "sharp": ">=0.35.0",
      "js-yaml@>=4.0.0": "^4.3.0",
      "fast-uri": ">=3.1.4",
      "jsonpath-plus": ">=10.3.0",
      "tar": ">=7.5.16",
      "esbuild": ">=0.28.1",
      "hono": ">=4.12.27",
      "@hono/node-server": ">=2.0.5",
      "body-parser": ">=2.3.0",
      "fast-xml-parser": ">=5.10.1",
      "linkify-it": ">=5.0.2",
      "ajv@>=6.0.0 <7.0.0": "^6.12.3",
      "@babel/core": ">=7.29.6",
      "next@>=13.0.0 <16.0.0": "^15.5.21"
    }
  }
}
