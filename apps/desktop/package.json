{
  "name": "@heymoa/desktop",
  "version": "0.1.7",
  "private": true,
  "description": "HeyMoa desktop remote web shell",
  "author": "HeyMoa",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json",
    "build": "tsc && tsc -p tsconfig.renderer.json && node scripts/build-renderer.mjs",
    "test": "pnpm build && node --test test/*.test.cjs",
    "dev": "pnpm build && electron .",
    "package:dir": "pnpm build && electron-builder --mac --dir --publish never && node scripts/verify-package.cjs",
    "icons:verify": "node scripts/verify-icons.mjs",
    "package:mac:arm64": "pnpm build && pnpm icons:verify && electron-builder --mac dmg zip --arm64 --publish never && node scripts/verify-package.cjs && node scripts/checksums.mjs && node scripts/verify-update-feed.mjs release",
    "package:win:x64": "pnpm build && pnpm icons:verify && electron-builder --win nsis --x64 --publish never && node scripts/verify-package.cjs && node scripts/checksums.mjs && node scripts/verify-update-feed.mjs release"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@heymoa/desktop-contracts": "workspace:*",
    "@types/node": "^20",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "typescript": "^5"
  },
  "build": {
    "appId": "app.heymoa.desktop",
    "productName": "HeyMoa",
    "asar": true,
    "protocols": [
      {
        "name": "HeyMoa authentication",
        "schemes": [
          "app.heymoa"
        ]
      }
    ],
    "artifactName": "HeyMoa-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/*.js",
      "dist/capture.html",
      "dist/meeting.html",
      "dist/meeting.css",
      "dist/onboarding.html",
      "dist/onboarding.css",
      "dist/onboarding-logo.png",
      "assets/*.png",
      "package.json",
      "LICENSE.txt",
      "!node_modules/**/*",
      "!node_modules",
      "dist/preferences.html",
      "dist/preferences.css"
    ],
    "mac": {
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "14.2",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "HeyMoa uses your microphone to record your voice in meetings.",
        "NSAudioCaptureUsageDescription": "HeyMoa uses system audio to record the people you hear in meetings.",
        "CFBundleLocalizations": [
          "ko",
          "en"
        ],
        "CFBundleDevelopmentRegion": "en"
      },
      "extraResources": [
        {
          "from": "build/localizations",
          "to": ".",
          "filter": [
            "**/InfoPlist.strings"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "en_US",
        "ko_KR"
      ],
      "displayLanguageSelector": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/team-minswon/homebrew-tap/releases/latest/download"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
