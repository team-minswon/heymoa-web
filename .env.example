# web 이 읽는 환경변수 전부입니다. 랩(heymoa-lab)이 환경마다 값을 갈아 끼울 때
# 여기 없는 이름을 주면 **아무 일도 일어나지 않습니다** — Next 는 `process.env.KEY` 가
# 소스에 리터럴로 있어야 읽습니다.
#
# `NEXT_PUBLIC_` 접두사는 빌드 시점에 번들에 박힙니다. 값을 바꾸려면 다시 구워야 합니다.
# 접두사가 없는 것은 실행 시점에 읽으므로 다시 안 구워도 됩니다.

# 빈 값이면 MSW 목으로 돕니다 (`lib/auth/paths.ts` 의 `isAuthApiConfigured`).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# canonical · OG · robots.txt · sitemap.xml 이 가리키는 주소. 운영 도메인이 아니면
# `app/robots.ts` 가 `Disallow: /` 만 냅니다. 안 주면 운영 기본값입니다.
# 🔴 robots.txt · sitemap.xml 은 빌드 시점에 구워지므로 `pnpm build` **전에** 있어야 합니다.
NEXT_PUBLIC_SITE_URL=https://heymoa.app

# enabled 면 MSW 가 API 를 가로챕니다. 실제 서버에 붙일 때는 disabled 여야 합니다.
NEXT_PUBLIC_API_MOCKING=disabled

# 만료된 인증 쿠키를 지울 때 쓰는 Domain. **빈 값이면 host-only 로 지웁니다** —
# 서버가 host-only 로 심는 환경(랩의 서브도메인마다 한 벌)이 그렇습니다.
# 안 주면 운영 기본값(`.heymoa.app`)입니다. 실행 시점에 읽습니다.
AUTH_COOKIE_DOMAIN=
