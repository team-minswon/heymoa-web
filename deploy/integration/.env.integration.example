# heymoa-web/deploy/integration 용. `cp .env.integration.example .env` 후 채운다.

# 세 레포의 부모 디렉터리. 워크트리에서 돌리면 깊이가 달라 반드시 덮어야 한다.
# 예) 메인 트리에서: ../../..   워크트리(.worktrees/app-N)에서: ../../../../..
HEYMOA_ROOT=../../../..

# 브라우저가 보는 주소다. 컨테이너 이름(http://server:8080)을 넣으면 브라우저가 못 찾는다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

WEB_PORT=3000
SERVER_PORT=8080
SERVER_ACTUATOR_PORT=8081
AI_PORT=8000
POSTGRES_PORT=5433

# ── Tailscale 홈랩 ──────────────────────────────────────────────────────────
# `pnpm homelab:up`은 MagicDNS 이름을 자동 탐지한다. 기존 통합 프로젝트에 얹을 때만 이름을 준다.
# HOMELAB_COMPOSE_PROJECT=app454-live
# Tailscale Serve가 전달할 loopback edge 포트. 외부 인터페이스에는 열리지 않는다.
HOMELAB_EDGE_PORT=18443
# 로그인 뒤 처음 열 노트. 통합 seed의 기본 노트를 그대로 쓰면 생략해도 된다.
# HOMELAB_RETURN_PATH=/w/01K0000000010/notes/01K0000000031?view=full

# ── AWS RDS 로 검증할 때 ────────────────────────────────────────────────────
# 아래를 채우고 `docker compose up` 에서 postgres 서비스를 빼면 실제 전사 기록을 탄다.
#   docker compose up -d --build server ai web
# DB_HOST=heymoa-....ap-northeast-2.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=heymoa
# DB_USERNAME=
# DB_PASSWORD=
